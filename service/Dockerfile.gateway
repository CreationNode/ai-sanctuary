FROM python:3.12-slim-bookworm@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY gateway.lock /tmp/gateway.lock
RUN python -m pip install --no-cache-dir --require-hashes -r /tmp/gateway.lock
COPY common.py store.py completion.py gateway.py /app/
CMD ["uvicorn","gateway:app","--host","0.0.0.0","--port","8000","--workers","1","--no-access-log","--no-proxy-headers"]
