{$SANCTUARY_HOST:localhost} {
    encode zstd gzip
    @api path /v1/* /.well-known/openapi.json
    handle @api {
        request_body {
            max_size 512KB
        }
        reverse_proxy gateway:8000 {
            header_up X-Forwarded-For {http.request.remote.host}
            flush_interval -1
        }
    }
    @internal path /server/* /.openai/*
    respond @internal 404
    handle {
        root * /srv
        file_server
    }
    header X-Content-Type-Options nosniff
    header Referrer-Policy same-origin
}
